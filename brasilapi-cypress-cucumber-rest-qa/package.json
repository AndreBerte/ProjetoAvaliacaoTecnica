{
  "name": "brasilapi-cypress-cucumber-rest-qa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "cypress run",
    "test:smoke": "cypress run --env grepTags=@smoke",
    "test:negative": "cypress run --env grepTags=@negative",
    "test:regression": "cypress run --env grepTags=@regression",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^23.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.4",
    "@shelex/cypress-allure-plugin": "^2.41.0",
    "allure-commandline": "^2.34.1",
    "cypress": "^15.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-cypress": "^5.0.0",
    "prettier": "^3.0.0"
  }
}
